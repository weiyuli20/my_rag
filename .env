# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，绝不要提交

# ---------- 必填：数据库 ----------
PG_DSN=postgresql://postgres:postgres@localhost:5438/postgres

# ---------- 必填：Embedding（检索层）----------
# 注意：变量名必须是 AI_DASHSCOPE_API_KEY，代码里读的就是这个名字
AI_DASHSCOPE_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:21434/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_MODEL=bge-m3:latest

# ---------- 生成层：二选一，默认 local ----------
# local = 本地模型（推荐：零成本、数据不出内网、不依赖任何云端 key）
# api   = 云端大模型（推荐：没有能跑的本地显存/内存时）
LLM_BACKEND=local

# local 模式配置：把下面的地址和模型名改成你本机推理服务暴露的值
# 方案 A：Unsloth Studio 自带 llama-server（装了 Unsloth.app 就有）
#   端口在 Unsloth Studio 界面里能看到，key 在 ~/.unsloth/studio/auth/llama_api_key_*
LOCAL_BASE_URL=http://127.0.0.1:21434/v1
LOCAL_KEY=ollama
LOCAL_MODEL=qwen3:8b
# 方案 B：oMLX（pip install omlx；模型名 = ~/.omlx/models 下的目录名）
# LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_MODEL=Qwen2.5-0.5B

# api 模式配置：只有 LLM_BACKEND=api 时才需要填 DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=sk-xxx